# Copy to deploy/.env and fill in. Never commit the real file.
# Make each secret with: openssl rand -base64 48

# The address people use, without https://
DOMAIN=labels.example.org

SESSION_SECRET=
# Encrypts two-factor secrets. Changing it turns off everyone's two-factor login.
SECRETS_KEY=

MONGO_ROOT_PASSWORD=
MONGO_APP_PASSWORD=

# Any SMTP service, for invites, confirmations, and password resets
SMTP_URL=smtps://user:password@smtp.example.com
MAIL_FROM="Manchu Labelling <labels@example.org>"
# Where security alerts go. Optional.
ALERT_EMAIL=

# Cloudflare R2, for nightly backups
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
